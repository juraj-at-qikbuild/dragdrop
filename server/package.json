{
  "name": "blava-city-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blava City multiplayer game server (one shared world). Deployed to Fly.io.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx scripts/loadtest.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
